# Chép thành .env rồi sửa:  cp .env.example .env
# KHÔNG commit .env — nó chứa mật khẩu thật.

TZ=Asia/Ho_Chi_Minh
SHARED_NETWORK=slm_v2_app-network

# ---- PostgreSQL: database riêng slm_ai (không dùng chung database với slm_v2) ----
DB_URL=jdbc:postgresql://<db-host>:5432/slm_ai
DB_USERNAME=slm_ai
DB_PASSWORD=doi-mat-khau-o-day

# ---- JWT: chuỗi ngẫu nhiên tối thiểu 32 byte. Sinh bằng: openssl rand -base64 48 ----
JWT_SIGNER_KEY=
JWT_ACCESS_TOKEN_TTL=8h
JWT_REFRESH_TOKEN_TTL=7d

# ---- Tài khoản SYSTEM_ADMIN đầu tiên (chỉ tạo khi chưa có quản trị viên nào) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- MinIO: bucket riêng cho media của bot (mục 6) ----
MINIO_ENDPOINT=http://<minio-host>:9000
MINIO_PUBLIC_URL=https://<ten-mien-media>
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=slm-ai-media

# Để trống = không bật CORS (CMS gọi API qua nginx cùng tên miền)
CORS_ALLOWED_ORIGINS=
